/* PDP-11 prims instruction templates for the B image writer. */
prims(){
    emit("/ brt.s — runtime helpers for bcc-pdp.*n/*n/ Calls place the leftmost argument nearest the return address.*n/ Function cells are called via `jsr pc, **_name`; args at 2(sp), 4(sp), ...*n/ Result returned");
    emit(" in r0. Helpers preserve no callee-save regs.*n*n/ Syscall numbers (V1 manual section II)*nsexit   = 1.*nsfork   = 2.*nread    = 3.*nswrite  = 4.*nsopen   = 5.*nsclose  = 6.*nswait   = 7.*nscreat  = 8.*nslink   ");
    emit("= 9.*nsunlink = 10.*nsexec   = 11.*nschdir  = 12.*nstime   = 13.*nsmkdir  = 14.*nschmod  = 15.*nschown  = 16.*nsbreak  = 17.*nsstat   = 18.*nsseek   = 19.*nstty    = 31.*nsgtty   = 32.*nssetuid = 23.*nsgetuid = 24.");
    emit("*nsstime  = 25.*nsfstat  = 28.*n*n.globl*t_putchar*n.globl*t_getchar*n.globl*t_write*n.globl*t_read*n.globl*t_open*n.globl*t_close*n.globl*t_creat*n.globl*t_seek*n.globl*t_exit*n.globl*t_putstr*n.globl*t_char*n.globl*t_lchar*n.g");
    emit("lobl*t_unlink*n*n/ B word marker for end-of-string ('**e' in B source, 04 octal)*nEOT = 4*n*n/ ---- _exit(code) ----*n_exit:*n*t.+2*n*tmov*t2(sp), r0*n*tsys*tsexit*n*n/ ---- _putchar(c) ----*n_putchar:*n*t.+2*n*tmov*t2(sp), ");
    emit("pcbuf*n*tmov*t$1, r0*t*t*t/ fd = stdout*n*ttstb*tpcbuf+1*n*tbeq*t1f*n*tswab*tpcbuf*t*t*t/ packed pair: high byte first*n*tsys*tswrite; pcbuf; 2.*n*trts*tpc*n1:*n*tsys*tswrite; pcbuf; 1.*n*trts*tpc*npcbuf:*t0*n*n/ ---- _getchar() -> int");
    emit(" (char, or **e on EOF) ----*n_getchar:*n*t.+2*n*tclr*tr0*t*t*t/ fd = stdin*n*tsys*tread; gcbuf; 1.*n*tbes*t1f*n*ttst*tr0*n*tbeq*t2f*t*t*t/ EOF*n*tmovb*tgcbuf, r0*n*tbic*t$177400, r0*n*trts*tpc*n1:*n2:*n*tmov*t$EOT, r0*n*trts*tpc*ngcbuf:*t0*n*n/ -");
    emit("--- _write(fd, buf, n) ----*n_write:*n*t.+2*n*tmov*t2(sp), r0*n*tmov*t4(sp), 0f*n*tasl*t0f*n*tmov*t6(sp), 0f+2*n*tsys*twrite; 0:..; ..*n*tbes*t1f*n*trts*tpc*n1:*n*tmov*t$-1, r0*n*trts*tpc*n*n/ ---- _read(fd, buf, n) ----*n_read:*n*t.+2*n");
    emit("*tmov*t2(sp), r0*n*tmov*t4(sp), 0f*n*tasl*t0f*n*tmov*t6(sp), 0f+2*n*tsys*tread; 0:..; ..*n*tbes*t1f*n*trts*tpc*n1:*n*tmov*t$-1, r0*n*trts*tpc*n*n/ ---- _open(path, mode): convert the B terminator before the syscall. ----*n_open:*n*t");
    emit(".+2*n*tmov*t2(sp), r0*n*tjsr*tpc, .path1*n*tbes*t9f*n*t/ Canonicalize every nonzero B mode to write-only, not host open flags.*n*tclr*t0f+2*n*ttst*t4(sp)*n*tbeq*t1f*n*tinc*t0f+2*n1:*n*tsys*tsopen; 0:.bp1; ..*n*tbes*t9f*n*trts*tpc*n9:*n");
    emit("*tmov*t$-1, r0*n*trts*tpc*n*n/ ---- _close(fd) ----*n_close:*n*t.+2*n*tmov*t2(sp), r0*n*tsys*tsclose*n*tbes*t1f*n*trts*tpc*n1:*n*tmov*t$-1, r0*n*trts*tpc*n*n/ ---- _creat(path, mode): convert the B terminator before the syscall. --");
    emit("--*n_creat:*n*t.+2*n*tmov*t2(sp), r0*n*tjsr*tpc, .path1*n*tbes*t9f*n*tmov*t4(sp), 0f+2*n*tsys*tscreat; 0:.bp1; ..*n*tbes*t9f*n*trts*tpc*n9:*n*tmov*t$-1, r0*n*trts*tpc*n*n/ ---- _seek(fd, offset, origin) ----*n_seek:*n*t.+2*n*tmov*t2(sp), r");
    emit("0*n*tmov*t4(sp), 0f*n*tmov*t6(sp), 0f+2*n*tsys*tsseek; 0:..; ..*n*tbes*t9f*n*tclr*tr0*n*trts*tpc*n9:*n*tmov*t$-1, r0*n*trts*tpc*n*n/ ---- _putstr(s) — print chars until EOT (04) ----*n_putstr:*n*t.+2*n*tmov*t2(sp), r1*n*tasl*tr1*n1:*n*tm");
    emit("ovb*t(r1)+, r0*n*tcmpb*tr0, $EOT*n*tbeq*t2f*n*tbic*t$177400, r0*n*tmov*tr1, -(sp)*t*t/ replacement functions may clobber r1*n*tmov*tr0, -(sp)*n*tjsr*tpc, **_putchar*n*ttst*t(sp)+*n*tmov*t(sp)+, r1*n*tbr*t1b*n2:*n*trts*tpc*n*n*n/ ---- .mul");
    emit(": TOS = LHS, R0 = RHS (caller pushed both). Helper pops both. ----*n.globl*t.mul*n.mul:*n*tmov*t(sp)+, r2*t*t/ r2 = return PC*n*tmov*t(sp)+, r0*t*t/ r0 = RHS*n*tmov*t(sp)+, r1*t*t/ r1 = LHS*n*tclr*tr3*n*tmov*t$16., r4*n1:*n*tas");
    emit("r*tr0*n*tbcc*t2f*n*tadd*tr1, r3*n2:*n*tasl*tr1*n*tdec*tr4*n*tbne*t1b*n*tmov*tr3, r0*n*tjmp*t(r2)*n*n/ Signed division truncates toward zero; the loop divides unsigned magnitudes.*n/ Save R5 because it is the caller's frame poi");
    emit("nter.*n.globl .div*n.div:*n*tmov (sp)+, r2*n*tmov (sp)+, r0*n*tmov (sp)+, r1*n*tmov r5, -(sp)*n*tclr r5*n*ttst r1*n*tbge 1f*n*tneg r1*n*tinc r5*n1:*n*ttst r0*n*tbge 2f*n*tneg r0*n*tinc r5*n2:*n*tclr r3*n*tmov $16., r4*n3:*n*tasl r1*n*trol ");
    emit("r3*n*tcmp r3, r0*n*tblo 4f*n*tsub r0, r3*n*tinc r1*n4:*n*tdec r4*n*tbne 3b*n*tbit $1, r5*n*tbeq 5f*n*tneg r1*n5:*n*tmov r1, r0*n*tmov (sp)+, r5*n*tjmp (r2)*n*n/ Remainders follow the dividend's sign for the chosen truncation rul");
    emit("e.*n.globl .mod*n.mod:*n*tmov (sp)+, r2*n*tmov (sp)+, r0*n*tmov (sp)+, r1*n*tmov r5, -(sp)*n*tclr r5*n*ttst r1*n*tbge 1f*n*tneg r1*n*tinc r5*n1:*n*ttst r0*n*tbge 2f*n*tneg r0*n2:*n*tclr r3*n*tmov $16., r4*n3:*n*tasl r1*n*trol r3*n*tcmp r3,");
    emit(" r0*n*tblo 4f*n*tsub r0, r3*n*tinc r1*n4:*n*tdec r4*n*tbne 3b*n*ttst r5*n*tbeq 5f*n*tneg r3*n5:*n*tmov r3, r0*n*tmov (sp)+, r5*n*tjmp (r2)*n*n/ ---- .shl: LHS << RHS, result in R0. ----*n.globl*t.shl*n.shl:*n*tmov*t(sp)+, r2*n*tmov*t(s");
    emit("p)+, r0*t*t/ r0 = shift count*n*tmov*t(sp)+, r1*t*t/ r1 = value*n*ttst*tr0*n*tbeq*t2f*n1:*n*tasl*tr1*n*tdec*tr0*n*tbne*t1b*n2:*n*tmov*tr1, r0*n*tjmp*t(r2)*n*n/ ---- .shr: LHS >> RHS, result in R0. Logical shift (unsigned). ----*n.glo");
    emit("bl*t.shr*n.shr:*n*tmov*t(sp)+, r2*n*tmov*t(sp)+, r0*n*tmov*t(sp)+, r1*n*ttst*tr0*n*tbeq*t2f*n1:*n*tclc*n*tror*tr1*n*tdec*tr0*n*tbne*t1b*n2:*n*tmov*tr1, r0*n*tjmp*t(r2)*n*n/ ---- .xor: LHS ^ RHS, result in R0. PDP-11 has no xor; use bic+bi");
    emit("s.*n/ Kept for backward compat though strict 1972 lexer no longer emits ^. ----*n.globl*t.xor*n.xor:*n*tmov*t(sp)+, r2*n*tmov*t(sp)+, r0*n*tmov*t(sp)+, r1*n*tmov*tr0, r3*n*tmov*tr1, r4*n*tbic*tr0, r1*t*t*t/ r1 = LHS & ~RHS*n*tb");
    emit("ic*tr4, r3*t*t*t/ r3 = RHS & ~LHS*n*tbis*tr1, r3*t*t*t/ r3 = (LHS&~RHS) | (RHS&~LHS) = XOR*n*tmov*tr3, r0*n*tjmp*t(r2)*n*n*n/ =========== kbman §8 library: char, lchar ===========*n/ String values are B word addresses; ");
    emit("character indices count bytes.*n/ char(s, i) = the i-th byte; lchar(s, i, c) sets it.*n*n/ ---- _char(s, i) -> int (byte zero-extended) ----*n_char:*n*t.+2*n*tmov*t2(sp), r0*t*t/ r0 = s (B word address)*n*tasl*tr0*n");
    emit("*tadd*t4(sp), r0*t*t/ r0 = &s[i]*n*tclr*tr1*n*tbisb*t(r0), r1*t*t/ r1 = zero-extended byte*n*tmov*tr1, r0*n*trts*tpc*n*n/ ---- _lchar(s, i, c) ----*n_lchar:*n*t.+2*n*tmov*t2(sp), r0*n*tasl*tr0*n*tadd*t4(sp), r0*t*t/ r0 = &s[i]*n*tmov*t6(");
    emit("sp), r1*t*t/ r1 = c*n*tmovb*tr1, (r0)*n*tmov*tr1, r0*t*t/ return the supplied character, not its byte address*n*trts*tpc*n*n*n/ =========== kbman §8 library: V1 syscall wrappers ===========*n*n/ ---- _fork(): the pare");
    emit("nt skips the instruction after sys fork. ----*n/ bcc-meta-begin*n.globl*t_fork*n.globl*t_wait*n.globl*t_chdir*n.globl*t_link*n.globl*t_chmod*n.globl*t_chown*n.globl*t_stat*n.globl*t_fstat*n.globl*t_stty*n.globl*t_gtty*n.gl");
    emit("obl*t_setuid*n.globl*t_getuid*n.globl*t_time*n.globl*t_mkdir*n.globl*t_makdir*n_fork:*n*t.+2*n*tsys*tsfork*n*tbr*t1f*n*tbcc*t2f*n*tmov*t$-1, r0*n*trts*tpc*n1:*n*tclr*tr0*n2:*n*trts*tpc*n*n_wait:*n*t.+2*n*tsys*tswait*n*tbes*t9f*n*trts*tpc*n9:*n*tmov*t$-");
    emit("1, r0*n*trts*tpc*n*n/ bcc-meta-end*n_unlink:*n*t.+2*n*tmov*t2(sp), r0*n*tjsr*tpc, .path1*n*tbes*t9f*n*tsys*tsunlink; .bp1*n*tbes*t9f*n*tclr*tr0*n*trts*tpc*n9:*n*tmov*t$-1, r0*n*trts*tpc*n*n/ bcc-meta-begin*n_chdir:*n*t.+2*n*tmov*t2(sp), r0*n*tjsr");
    emit("*tpc, .path1*n*tbes*t9f*n*tsys*tschdir; .bp1*n*tbes*t9f*n*tclr*tr0*n*trts*tpc*n9:*n*tmov*t$-1, r0*n*trts*tpc*n*n_link:*n*t.+2*n*tmov*t2(sp), r0*n*tjsr*tpc, .path1*n*tbes*t9f*n*tmov*t4(sp), r0*n*tjsr*tpc, .path2*n*tbes*t9f*n*tsys*tslink; .bp1; .bp2*n");
    emit("*tbes*t9f*n*tclr*tr0*n*trts*tpc*n9:*n*tmov*t$-1, r0*n*trts*tpc*n*n_chmod:*n*t.+2*n*tmov*t2(sp), r0*n*tjsr*tpc, .path1*n*tbes*t9f*n*tmov*t4(sp), 0f+2*n*tsys*tschmod; 0:.bp1; ..*n*tbes*t9f*n*tclr*tr0*n*trts*tpc*n9:*n*tmov*t$-1, r0*n*trts*tpc*n*n_chown:*n*t");
    emit(".+2*n*tmov*t2(sp), r0*n*tjsr*tpc, .path1*n*tbes*t9f*n*tmov*t4(sp), 0f+2*n*tsys*tschown; 0:.bp1; ..*n*tbes*t9f*n*tclr*tr0*n*trts*tpc*n9:*n*tmov*t$-1, r0*n*trts*tpc*n*n_stat:*n*t.+2*n*tmov*t2(sp), r0*n*tjsr*tpc, .path1*n*tbes*t9f*n*tmov*t4(sp), 0f+2");
    emit("*n*tasl*t0f+2*n*tsys*tsstat; 0:.bp1; ..*n*tbes*t9f*n*tclr*tr0*n*trts*tpc*n9:*n*tmov*t$-1, r0*n*trts*tpc*n*n_makdir:*n*t.+4*n_mkdir:*n*t.+2*n*tmov*t2(sp), r0*n*tjsr*tpc, .path1*n*tbes*t9f*n*tmov*t4(sp), 0f+2*n*tsys*tsmkdir; 0:.bp1; ..*n*tbes*t9f*n*tc");
    emit("lr*tr0*n*trts*tpc*n9:*n*tmov*t$-1, r0*n*trts*tpc*n*n_fstat:*n*t.+2*n*tmov*t2(sp), r0*n*tmov*t4(sp), 0f*n*tasl*t0f*n*tsys*tsfstat; 0:..*n*tbes*t9f*n*tclr*tr0*n*trts*tpc*n9:*n*tmov*t$-1, r0*n*trts*tpc*n*n_stty:*n*t.+2*n*tmov*t2(sp), r0*n*tmov*t4(sp), 0f*n*t");
    emit("asl*t0f*n*tsys*tstty; 0:..*n*tbes*t9f*n*tclr*tr0*n*trts*tpc*n9:*n*tmov*t$-1, r0*n*trts*tpc*n*n_gtty:*n*t.+2*n*tmov*t2(sp), r0*n*tmov*t4(sp), 0f*n*tasl*t0f*n*tsys*tsgtty; 0:..*n*tbes*t9f*n*tclr*tr0*n*trts*tpc*n9:*n*tmov*t$-1, r0*n*trts*tpc*n*n_setuid:*n*t.+");
    emit("2*n*tmov*t2(sp), r0*n*tsys*tssetuid*n*tbes*t9f*n*tclr*tr0*n*trts*tpc*n9:*n*tmov*t$-1, r0*n*trts*tpc*n*n_getuid:*n*t.+2*n*tsys*tsgetuid*n*trts*tpc*n*n/ V1 time returns the high and low words in the KE11 AC and MQ registers.*n_time:*n*t.+2");
    emit("*n*tsys*tstime*n*tmov*t2(sp), r2*n*tasl*tr2*n*tmov*tac, (r2)+*n*tmov*tmq, (r2)*n*tclr*tr0*n*trts*tpc*n*n/ bcc-meta-end*n*n/ bcc-exec-begin*n.globl*t_execv*n.globl*t_execl*n/ B72 execv takes a counted vector, not a zero-terminated ");
    emit("B vector.*n_execv:*n*t.+2*n*tmov*t2(sp), r0*n*tjsr*tpc, .path1*n*tbes*t9f*n*tmov*t6(sp), r3*n*tblt*t9f*n*tcmp*tr3, $64.*n*tbhi*t9f*n*tmov*tr3, .ecnt*n*tmov*t4(sp), r4*n*tasl*tr4*n*tmov*t$.earg, .evp*n*tmov*t$.estr, r1*n*tmov*t$512., r2*n1:*n*tts");
    emit("t*t.ecnt*n*tbeq*t2f*n*ttst*tr4*n*tbeq*t9f*n*tmov*t(r4)+, r0*n*tmov*t.evp, r3*n*tmov*tr1, (r3)+*n*tmov*tr3, .evp*n*tjsr*tpc, .strz*n*tbes*t9f*n*tdec*t.ecnt*n*tbr*t1b*n2:*n*tmov*t.evp, r3*n*tclr*t(r3)*n*tsys*tsexec; .bp1; .earg*n9:*n*tmov*t$-1, r0*n*tr");
    emit("ts*tpc*n*n/ The variadic arguments already form a contiguous vector on the stack.*n_execl:*n*t.+2*n*tmov*tsp, r1*n*tadd*t$4, r1*n*tclr*tr2*n1:*n*ttst*t(r1)+*n*tbeq*t2f*n*tinc*tr2*n*tcmp*tr2, $64.*n*tbhi*t9f*n*tbr*t1b*n2:*n*tmov*t2(sp), r3");
    emit("*n*tmov*tsp, r0*n*tadd*t$4, r0*n*tasr*tr0*n*tmov*tr2, -(sp)*n*tmov*tr0, -(sp)*n*tmov*tr3, -(sp)*n*tjsr*tpc, **_execv*n*tadd*t$6, sp*n*trts*tpc*n9:*n*tmov*t$-1, r0*n*trts*tpc*n*n/ bcc-exec-end*n*n/ Convert a B byte string to NUL-terminated ");
    emit("syscall storage.*n/ R0 is a B word address, R1 a byte destination, R2 remaining bytes; R4 and R5 are preserved.*n.path1:*n*tmov*t$.bp1, r1*n*tmov*t$256., r2*n*tbr*t.strz*n/ bcc-meta-begin*n.path2:*n*tmov*t$.bp2, r1*n*t");
    emit("mov*t$256., r2*n/ bcc-meta-end*n.strz:*n*ttst*tr0*n*tbeq*t9f*n*tasl*tr0*n1:*n*ttst*tr2*n*tbeq*t9f*n*tmovb*t(r0)+, r3*n*tbeq*t2f*n*tcmpb*tr3, $4*n*tbeq*t2f*n*tmovb*tr3, (r1)+*n*tdec*tr2*n*tbr*t1b*n2:*n*tclrb*t(r1)+*n*tdec*tr2*n*tclc*n*trts*tpc*n9:*n*tsec*n*t");
    emit("rts*tpc*n.even*n/ bcc-exec-begin*n.ecnt: 0*n.evp: 0*n.earg: .=.+130.*n.estr: .=.+512.*n/ bcc-exec-end*n.bp1: .=.+256.*n/ bcc-meta-begin*n.bp2: .=.+256.*n/ bcc-meta-end*n*n/ _ctime is implemented in runtime/libb.b.*n");
}
